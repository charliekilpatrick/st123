# =============================================================================
# st123 .gitignore
# Grouped by purpose. Prefer narrow patterns; use exceptions (!) when a
# broad rule would hide files that belong in git (e.g. requirements.txt).
# =============================================================================

# -----------------------------------------------------------------------------
# Python bytecode / caches
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# -----------------------------------------------------------------------------
# Packaging / install artifacts (setuptools, wheels, editable installs)
# -----------------------------------------------------------------------------
build/
dist/
wheels/
sdist/
*.egg
*.egg-info/
.eggs/
MANIFEST
pip-wheel-metadata/

# Version file written by setuptools-scm at build/install time (see pyproject.toml)
st123/_version.py

# -----------------------------------------------------------------------------
# Virtual environments
# -----------------------------------------------------------------------------
.venv/
venv/
ENV/
env/

# -----------------------------------------------------------------------------
# Test / coverage / typecheck / lint caches (pytest, coverage, mypy, ruff, tox)
# -----------------------------------------------------------------------------
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
pytestdebug.log

# -----------------------------------------------------------------------------
# Jupyter / IPython
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
.ipython/
*/.ipynb_checkpoints/

# Local scratch notebooks (not the packaged st123/notebooks templates)
plots.ipynb
bug.ipynb
process_data.ipynb
frb.ipynb

# -----------------------------------------------------------------------------
# Editors / IDEs / OS junk
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_STORE
Thumbs.db

# Local Cursor state (project rules stay machine-local; never push)
.cursor/

# Local analysis / scratch scripts (not part of the package).
# Ignore contents of examples/, then re-include the reusable M51/M82 driver.
examples/*
!examples/m51_m82_warmstart/
!examples/m51_m82_warmstart/**
examples/m51_m82_warmstart/**/__pycache__/
examples/m51_m82_warmstart/**/*.pyc


# -----------------------------------------------------------------------------
# Secrets / local env (never commit credentials)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example

# -----------------------------------------------------------------------------
# Shell launchers (ad-hoc run scripts; keep the repo Python-entry-point based)
# -----------------------------------------------------------------------------
*.sh
launch.sh

# -----------------------------------------------------------------------------
# Astronomy / pipeline data products (large or regenerable; live under datasets)
# -----------------------------------------------------------------------------
# FITS science / DQ / sky / mosaics
*.fits
# ASDF (e.g. mosaic_gwcs.asdf) and NumPy dumps
*.asdf
*.npy
*.npz
# Catalogs / tables / logs often written next to reductions
*.coo
*.log
*.csv
*.dat
*.png
*.txt
!requirements.txt
!requirements-*.txt

# Dataset / reduction directory names commonly created beside the code
mastDownload/
raw/
*red*/
plots/
data/
*temp*
# Sphinx layout templates (must not be caught by *temp* above)
!docs/_templates/
!docs/_templates/**

# One-off local dataset folder that previously sat in an older checkout
frb20250316a/

# -----------------------------------------------------------------------------
# DOLPHOT outputs and sidecars
# Primary catalog is <name>.phot; DOLPHOT also writes several sidecar files.
# Accidental `dolphot -h` (flag mistaken for output basename) creates `-h*`.
# -----------------------------------------------------------------------------
*.phot
*.columns
*.pages
*.align
*.info
*.psfs
*.apcor
*.warnings
-h
